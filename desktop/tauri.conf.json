{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isla Studio",
  "version": "0.1.0",
  "identifier": "technologies.isla.studio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Isla Technologies",
    "category": "DeveloperTool",
    "shortDescription": "Teach your robot to move",
    "longDescription": "Train, test and run legged robots with Isla Studio.",
    "copyright": "Copyright Isla Technologies",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "payload/": "payload/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
